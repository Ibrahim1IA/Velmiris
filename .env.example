# ═══════════════════════════════════════════════════════════════════
# VELMIRYS — Variables d'environnement (déploiement Docker)
# Usage : cp .env.example .env puis remplir les valeurs.
# ⚠️ Arrêter tout serveur local sur le port 3000 (ex. pnpm dev) avant
#    docker compose up -d — le conteneur publie le port 3000.
# ⚠️ Règle Next.js : le préfixe NEXT_PUBLIC_ est obligatoire uniquement
#    pour les valeurs lues par le NAVIGATEUR. Elles sont inlinées au
#    build Docker (build args) → modifier puis docker compose up -d --build.
# ═══════════════════════════════════════════════════════════════════

# ── Sanity ──  sanity.io/manage → ton projet
# Project ID : Settings → API → « Project ID »
NEXT_PUBLIC_SANITY_PROJECT_ID="TODO"          # ex. a1b2c3d4
# Dataset (défaut : « production »)
NEXT_PUBLIC_SANITY_DATASET="production"
# Version d'API : date arbitraire (jamais une date future)
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-19"
# Token serveur : API → Tokens → « Add API token » → permission « Editor »
# Usage : seed et mutations serveur uniquement — JAMAIS dans le navigateur.
SANITY_WRITE_TOKEN="TODO"                     # ex. sk9f8e7d6...

# ── Supabase ──  supabase.com/dashboard → projet → Settings → API Keys
# Project URL (serveur)
SUPABASE_PROJECT_URL="TODO"                   # ex. https://abcd1234.supabase.co
# Alias publics pour le navigateur (Next.js n'expose que NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="TODO"               # ex. https://abcd1234.supabase.co
# Publishable key (clé publique, sûre côté navigateur)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="TODO"   # ex. sb_publishable_...
# Secret key (clé secrète : accès total, SERVEUR UNIQUEMENT — API /api/orders)
# ⚠️ Les anciennes clés « anon » / « service_role » sont dépréciées (retrait fin 2026).
SUPABASE_SECRET_KEY="TODO"                    # ex. sb_secret_...

# ── Resend ──  resend.com → API Keys
# Notification email de nouvelle commande
RESEND_API_KEY="TODO"                         # ex. re_...

# ── Boutique ──
# Email qui reçoit les notifications de commande
SHOP_EMAIL="TODO"
# Numéro WhatsApp de la boutique, format international sans « + »
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER="TODO"       # ex. 212617190563

# ── Site ──
# URL canonique du site (SEO : sitemap, canonical, OG). Sans trailing slash.
NEXT_PUBLIC_SITE_URL="https://velmirys.com"

# ── Analytics Umami (optionnel) ──
# Laisser vide = analytics désactivé (no-op, ne casse jamais le site)
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ── Admin ── supabase.com/dashboard → Authentication → URL Configuration
# Email unique autorisé à accéder à /admin (magic link)
ADMIN_EMAIL="TODO"                            # ex. admin@velmirys.com
